# Supabase -> Project Settings -> Database -> Connection string
# DATABASE_URL: Transaction pooler (port 6543)  |  DIRECT_URL: Direct/Session connection (port 5432)
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Same project URL as the frontend (used to verify login tokens)
VITE_SUPABASE_URL="https://YOUR_REF.supabase.co"

# Secret for the automated sync (Vercel sends it automatically to the cron job). Any long random string.
CRON_SECRET=

PORT=5000
CLIENT_ORIGIN="http://localhost:5173"

# Random secret used to encrypt users' own bank API keys (any long random string; never change it later)
ENCRYPTION_KEY=

# Optional built-in bank connection (your own Enable Banking app), used when a user has not saved their own.
# BANK_SHARED_USERS: your Supabase user ID(s), comma-separated, or * for all users (only if your app has full production access)
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
BANK_SHARED_USERS=

# (old, unused) TrueLayer sandbox bank connection
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI="http://localhost:5000/api/banking/callback"
